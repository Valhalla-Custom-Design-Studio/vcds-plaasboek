# Plaasboek API — Environment Variables
# Copy to .env and fill in values

# Database
DATABASE_URL=postgresql://user:password@host:5432/plaasboek

# Auth
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# PayFast
PAYFAST_MERCHANT_ID=11910323
PAYFAST_MERCHANT_KEY=your-merchant-key
PAYFAST_PASSPHRASE=your-passphrase
PAYFAST_SANDBOX=false

# BulkSMS
BULKSMS_TOKEN_ID=your-token-id
BULKSMS_TOKEN_SECRET=your-token-secret

# Cloudflare R2
R2_ACCOUNT_ID=5aad73a7b1178f7db26f220ec21ac13e
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret
R2_BUCKET_NAME=lingering-glade-2094

# Sentry
SENTRY_DSN=your-sentry-dsn

# Cron
CRON_SECRET=your-cron-secret

# App
NODE_ENV=production
PORT=3000
CORS_ORIGIN=*
