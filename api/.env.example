# Plaasboek API — Environment Variables
NODE_ENV=production
PORT=3000

# Database
DATABASE_URL=postgresql://user:password@host:5432/plaasboek

# Auth
JWT_SECRET=your-jwt-secret-min-32-chars
JWT_EXPIRES_IN=7d

# PayFast
PAYFAST_MERCHANT_ID=11910323
PAYFAST_MERCHANT_KEY=your-merchant-key
PAYFAST_PASSPHRASE=your-passphrase
PAYFAST_SANDBOX=false
PAYFAST_URL=https://www.payfast.co.za/eng/process

# BulkSMS
BULKSMS_TOKEN_ID=your-bulksms-token-id
BULKSMS_TOKEN_SECRET=your-bulksms-token-secret

# Cloudflare R2
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET=your-bucket-name

# Sentry
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project

# CORS
ALLOWED_ORIGINS=https://plaasboek.vcds.co.za,http://localhost:8081

# Cron
CRON_SECRET=your-cron-secret-for-dms-check
