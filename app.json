{
  "expo": {
    "name": "Plaasboek\u2122",
    "slug": "plaasboek",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A1A0A"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "co.za.vcds.plaasboek",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Plaasboek uses your location for SOS emergency alerts.",
        "NSLocationAlwaysUsageDescription": "Plaasboek uses your location for Dead Man Switch background monitoring.",
        "NSCameraUsageDescription": "Plaasboek uses your camera to add photos to journal entries.",
        "NSPhotoLibraryUsageDescription": "Plaasboek accesses your photo library to attach images to journal entries."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A1A0A"
      },
      "package": "co.za.vcds.plaasboek",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "SEND_SMS",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "plaasboek"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./src/assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Plaasboek uses your location for SOS emergency alerts and Dead Man Switch monitoring."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./src/assets/notification-icon.png",
          "color": "#15803D",
          "sounds": []
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Plaasboek accesses your photos to attach images to journal entries.",
          "cameraPermission": "Plaasboek uses your camera to add photos to journal entries."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {}
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "valhalla-custom-design-studios",
          "project": "plaasboek"
        }
      ]
    ],
    "scheme": "plaasboek",
    "extra": {
      "eas": {
        "projectId": "56de3c11-ecf2-4e1f-9349-b42b5fd1eb0e"
      }
    },
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/plaasboek-vcds",
      "enabled": true,
      "fallbackToCacheTimeout": 0
    },
    "owner": "valhalla-custom-design-studios-org"
  }
}