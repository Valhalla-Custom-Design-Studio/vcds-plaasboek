{
  "cli": {
    "version": ">= 14.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "image": "sdk-53",
        "buildType": "apk"
      },
      "ios": {
        "image": "sdk-53",
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "image": "sdk-53",
        "buildType": "apk"
      },
      "ios": {
        "image": "sdk-53"
      },
      "env": {
        "SENTRY_AUTH_TOKEN": "$SENTRY_AUTH_TOKEN",
        "SENTRY_ORG": "valhalla-custom-design-studios",
        "SENTRY_PROJECT": "plaasboek"
      }
    },
    "production": {
      "android": {
        "image": "sdk-53",
        "buildType": "app-bundle"
      },
      "ios": {
        "image": "sdk-53"
      },
      "env": {
        "SENTRY_AUTH_TOKEN": "$SENTRY_AUTH_TOKEN",
        "SENTRY_ORG": "valhalla-custom-design-studios",
        "SENTRY_PROJECT": "plaasboek"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "internal"
      }
    }
  }
}