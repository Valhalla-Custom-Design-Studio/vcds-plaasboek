{
  "expo": {
    "name": "Plaasboek\u2122",
    "slug": "plaasboek",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#2D5016"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "co.za.vcds.plaasboek"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2D5016"
      },
      "package": "co.za.vcds.plaasboek",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-location",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Plaasboek to access your camera for photos."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#2D5016"
        }
      ]
    ],
    "scheme": "plaasboek",
    "extra": {
      "eas": {
        "projectId": "43a8ccbf-0000-0000-0000-000000000000"
      },
      "apiUrl": process.env.EXPO_PUBLIC_API_URL
    },
    "owner": "valhalla-custom-design-studios-org"
  }
}