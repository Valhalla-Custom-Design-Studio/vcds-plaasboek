# Plaasboek™ Environment Variables
# Copy to .env and fill in values

# API URL — NEVER use localhost in production
EXPO_PUBLIC_API_URL=https://your-railway-url.railway.app

# Auth
JWT_SECRET=your-jwt-secret-here

# PayFast
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=

# Sentry
SENTRY_DSN=

# BulkSMS
BULKSMS_TOKEN=
